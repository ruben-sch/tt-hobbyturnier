# Copy to $STACK_DIR/.env on the server. Never commit the real file.
TT_HOST=turnier.example.de
TT_ADMIN_PIN=bitte-lang-und-zufaellig
# Must match the Traefik on the server (defaults: websecure, letsencrypt, rs_proxy)
TT_ENTRYPOINT=websecure
TT_CERTRESOLVER=letsencrypt
TT_PROXY_NETWORK=rs_proxy
# Plain HTTP without TLS (e.g. home LAN like the ubiqiti stack): TT_ENTRYPOINT=http and TT_TLS=false
TT_TLS=true
